{
  "name": "@rajesh896/broprint.js",
  "version": "2.2.1",
  "description": "The world's easiest, smallest and powerful visitor identifier for browsers.",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.mjs",
      "types": "./lib/index.d.ts"
    },
    "./global": "./lib/index.global.js"
  },
  "private": false,
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir lib --declarationMap false",
    "build:bundle": "tsup src/index.ts --format esm,cjs,iife --global-name Broprint --out-dir lib --minify --clean --silent",
    "build": "npm run build:bundle && npm run build:types",
    "build:npm": "npm run build:bundle && npm run build:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" \"*.{ts,tsx,json}\"",
    "test": "echo \"Error: no test specified\" && exit 1 ",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajesh-Royal/Broprint.js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "browserfingerprint",
    "fingerprinting",
    "jsfingerprint",
    "uniquebrowserid",
    "nodejs",
    "cryptography",
    "fraud-detection",
    "canvas-fingerprinting",
    "audio-fingerprinting",
    "visitor-identifier",
    "identification",
    "reactjs",
    "javascript",
    "typescript"
  ],
  "author": "Rajesh-Royal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rajesh-Royal/Broprint.js/issues"
  },
  "homepage": "https://github.com/Rajesh-Royal/Broprint.js#readme",
  "files": [
    "lib",
    "LICENSE",
    "README.MD"
  ],
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.0"
  }
}
