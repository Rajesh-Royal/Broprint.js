{
  "name": "@rajesh896/broprint.js",
  "version": "2.2.0",
  "description": "The world's easiest, smallest and powerful visitor identifier for browsers.",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.mjs"
    },
    "./global": "./lib/index.global.js"
  },
  "private": false,
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir lib --declarationMap false",
  "build:bundle": "tsup src/index.ts --format esm,cjs,iife --global-name Broprint --out-dir lib --minify --clean --silent",
    "build": "npm run build:bundle && npm run build:types",
    "build:npm": "npm run build:bundle && npm run build:types",
    "test": "echo \"Error: no test specified\" && exit 1 "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rajesh-Royal/Broprint.js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "getDeviceId()": "./lib/index.js"
  },
  "keywords": [
    "browserfingerprint",
    "fingerprinting",
    "jsfingerprint",
    "uniquebrowserid",
    "nodejs",
    "cryptography",
    "fraud-detection",
    "canvas-fingerprinting",
    "audio-fingerprinting",
    "visitor-identifier",
    "identification",
    "reactjs",
    "javascript",
    "typescript"
  ],
  "author": "Rajesh-Royal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rajesh-Royal/Broprint.js/issues"
  },
  "homepage": "https://github.com/Rajesh-Royal/Broprint.js#readme",
  "files": [
    "lib",
    "LICENSE",
    "README.MD"
  ],
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.4.0"
  }
}
